#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."
hour=$(TZ=America/New_York date +%H%M)
if (( 10#$hour >= 2355 || 10#$hour < 300 )); then
  echo 'Quiet hours: no work may start between 23:55 and 03:00 America/New_York.' >&2
  exit 76
fi
export TMPDIR=/tmp/tween-$(date +%Y%m%dT%H%M%S)-$$
mkdir -p "$TMPDIR"
trap 'rm -rf -- "$TMPDIR"' EXIT
for mount in . /tmp; do
  available=$(df -Pk "$mount" | awk 'NR==2 {print $4}')
  if (( available < 5242880 )); then echo "Stopping: under 5 GiB free on $mount" >&2; exit 77; fi
done
export XDG_DATA_HOME="$TMPDIR/xdg-data" XDG_CONFIG_HOME="$TMPDIR/xdg-config" XDG_CACHE_HOME="$TMPDIR/xdg-cache"
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 LP_NUM_THREADS=2 MESA_GLTHREAD=false
export GIT_AUTHOR_NAME='Tween (agent)' GIT_AUTHOR_EMAIL='agents@noreply.invalid'
export GIT_COMMITTER_NAME='Tween (agent)' GIT_COMMITTER_EMAIL='agents@noreply.invalid'
"$@"
