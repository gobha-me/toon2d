{
  "name": "toon2d-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node ${TOON2D_SKILL:-../..}/scripts/serve.mjs .",
    "lint": "node ${TOON2D_SKILL:-../..}/scripts/lint.mjs .",
    "check": "node ${TOON2D_SKILL:-../..}/scripts/score.mjs . --out shots",
    "capture": "node ${TOON2D_SKILL:-../..}/scripts/capture.mjs . --out shots"
  },
  "//": "Set TOON2D_SKILL to the skill bundle dir when the project is not at <skill>/templates/starter."
}